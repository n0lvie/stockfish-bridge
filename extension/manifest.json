{
  "manifest_version": 3,
  "name": "Stockfish Bridge",
  "version": "1.0.0",
  "description": "Bridge between Stockfish engine and online chess platforms for engine tournaments",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.chess.com/*"],
      "js": ["content/common.js", "content/chess_com.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.lichess.org/*"],
      "js": ["content/common.js", "content/lichess.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*.chess.com/*", "*://*.lichess.org/*"],
      "js": ["content/common.js", "content/generic.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
